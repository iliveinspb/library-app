{
  "name": "library-app",
  "version": "1.0.0",
  "description": "",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json && npm run copy:assets",
    "copy:assets": "copyfiles -u 2 project/server/views/* dist && copyfiles -u 2 project/server/views/**/* dist && copyfiles -u 2 project/server/public/* dist && copyfiles -u 2 project/server/public/**/* dist",
    "start": "node dist/index.js",
    "dev": "nodemon --watch project/server --ext ts,js --exec \"npm run build && node dist/index.js\"",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/iliveinspb/library-app.git"
  },
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/iliveinspb/library-app/issues"
  },
  "homepage": "https://github.com/iliveinspb/library-app#readme",
  "dependencies": {
    "ejs": "^6.0.1",
    "express": "^5.2.1",
    "inversify": "^6.2.2",
    "mongoose": "^8.24.4",
    "multer": "^2.2.0",
    "reflect-metadata": "^0.2.2",
    "uuid": "^8.3.2"
  },
  "devDependencies": {
    "@types/ejs": "^3.1.5",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.2.0",
    "@types/node": "^26.6.3",
    "@types/uuid": "^10.0.0",
    "copyfiles": "^2.4.1",
    "nodemon": "^3.1.14",
    "typescript": "^7.0.2"
  }
}
